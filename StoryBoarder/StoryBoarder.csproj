<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\StoryBoarder.ico</ApplicationIcon>

    <!-- The installer takes its version from here. -->
    <Version>1.2.0</Version>
    <Product>Story Boarder</Product>
    <AssemblyTitle>Story Boarder</AssemblyTitle>
  </PropertyGroup>

</Project>
