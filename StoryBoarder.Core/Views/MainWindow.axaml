<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:StoryBoarder.Views"
        x:Class="StoryBoarder.Views.MainWindow"
        x:DataType="v:MainWindow"
        Icon="/Assets/StoryBoarder.ico"
        Title="{Binding #View.DocumentTitle}"
        Width="1400" Height="900" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <v:MainView x:Name="View"/>
</Window>
