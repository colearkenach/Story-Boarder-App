<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Story Boarder"
           Manufacturer="Black Flame Studios - Tools"
           Version="!(bind.FileVersion.StoryBoarderExe)"
           UpgradeCode="902C00A4-56F0-4919-B61E-1D0B06D5F294">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="..\StoryBoarder\Assets\StoryBoarder.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Story Boarder" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Story Boarder">
      <Component Directory="INSTALLFOLDER">
        <File Id="StoryBoarderExe" Source="$(var.AppDir)\StoryBoarder.exe" KeyPath="yes" />

        <!-- Double-clicking a .storyboard file opens it in Story Boarder. -->
        <ProgId Id="StoryBoarder.Board" Description="Story Boarder board" Icon="StoryBoarderExe" IconIndex="0">
          <Extension Id="storyboard" ContentType="application/x-storyboard">
            <Verb Id="open" TargetFile="StoryBoarderExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
      </Component>

      <!-- Shortcuts live in their own component; Windows Installer wants a registry key path for them. -->
      <Component Id="Shortcuts" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut" Name="Story Boarder" Target="[INSTALLFOLDER]StoryBoarder.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Story Boarder"
                  Target="[INSTALLFOLDER]StoryBoarder.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Story Boarder" Name="Shortcuts" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Standard wizard (welcome, install folder, install) with the license page skipped. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
    </UI>
  </Package>
</Wix>
